<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- Servlet Configuration Examples -->

    <!-- Hello Servlet -->
    <servlet>
        <servlet-name>HelloServlet</servlet-name>
        <servlet-class>Advance_Java.Sevlets.HelloServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HelloServlet</servlet-name>
        <url-pattern>/hello</url-pattern>
    </servlet-mapping>

    <!-- HTTP Servlet Example -->
    <servlet>
        <servlet-name>HttpServletExample</servlet-name>
        <servlet-class>Advance_Java.Sevlets.HttpServletExample</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HttpServletExample</servlet-name>
        <url-pattern>/http</url-pattern>
    </servlet-mapping>

    <!-- Dynamic Servlet -->
    <servlet>
        <servlet-name>DynamicServlet</servlet-name>
        <servlet-class>Advance_Java.Sevlets.DynamicServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DynamicServlet</servlet-name>
        <url-pattern>/dynamic</url-pattern>
    </servlet-mapping>

    <!-- Life Cycle Servlet -->
    <servlet>
        <servlet-name>LifeCycleServlet</servlet-name>
        <servlet-class>Advance_Java.Sevlets.LifeCycleServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>LifeCycleServlet</servlet-name>
        <url-pattern>/lifecycle</url-pattern>
    </servlet-mapping>

    <!-- Form Servlet -->
    <servlet>
        <servlet-name>FormServlet</servlet-name>
        <servlet-class>Advance_Java.Sevlets.FormServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FormServlet</servlet-name>
        <url-pattern>/FormServlet</url-pattern>
    </servlet-mapping>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
        <welcome-file>hello</welcome-file>
    </welcome-file-list>

</web-app>
